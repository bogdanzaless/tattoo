// ═══════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════
let lang     = 'en';
let section  = 'about';
let view     = 'icon';
let query    = '';
let hist     = ['about'];
let hIdx     = 0;
let isFullscreen = false;
let isMinimized  = false;
let selectedId   = null;

const d = () => DATA[lang];

// ═══════════════════════════════════════════
//  THEME
// ═══════════════════════════════════════════
let isDark = true;

function toggleTheme() {
  isDark = !isDark;
  document.getElementById('htmlRoot').classList.toggle('dark', isDark);
  document.getElementById('themeBtn').textContent = isDark ? '☀️' : '🌙';
}

// ═══════════════════════════════════════════
//  TRAFFIC LIGHTS
// ═══════════════════════════════════════════
function tlClose() {
  const w = document.getElementById('finderWindow');
  w.classList.add('closing');
  setTimeout(() => {
    w.classList.add('hidden');
    w.classList.remove('closing');
    document.getElementById('closedOverlay').classList.add('visible');
  }, 200);
}

function reopenWindow() {
  const w = document.getElementById('finderWindow');
  document.getElementById('closedOverlay').classList.remove('visible');
  w.classList.remove('hidden');
  w.style.opacity = '0';
  w.style.transform = 'scale(0.94)';
  requestAnimationFrame(() => {
    w.style.transition = 'opacity 0.22s,transform 0.3s cubic-bezier(0.34,1.2,0.64,1)';
    w.style.opacity = '1';
    w.style.transform = '';
    setTimeout(() => { w.style.transition = ''; }, 320);
  });
}

function tlMinimize() {
  if (isMinimized) { restoreWindow(); return; }
  const w = document.getElementById('finderWindow');
  isMinimized = true;
  w.classList.add('minimizing');
  setTimeout(() => {
    w.classList.add('hidden');
    w.classList.remove('minimizing');
    const dock = document.getElementById('miniDock');
    dock.style.display = 'flex';
    setTimeout(() => dock.classList.add('visible'), 10);
  }, 280);
}

function restoreWindow() {
  const dock = document.getElementById('miniDock');
  dock.classList.remove('visible');
  setTimeout(() => { dock.style.display = ''; }, 350);
  const w = document.getElementById('finderWindow');
  w.classList.remove('hidden');
  isMinimized = false;
  w.style.opacity = '0';
  w.style.transform = 'scale(0.88) translateY(30px)';
  requestAnimationFrame(() => {
    w.style.transition = 'opacity 0.28s,transform 0.38s cubic-bezier(0.34,1.3,0.64,1)';
    w.style.opacity = '1';
    w.style.transform = '';
    setTimeout(() => { w.style.transition = ''; }, 400);
  });
}

function tlFullscreen() {
  const w = document.getElementById('finderWindow');
  if (!isFullscreen) {
    if (w.requestFullscreen) {
      w.requestFullscreen().catch(() => cssFullscreen(true));
    } else {
      cssFullscreen(true);
    }
    isFullscreen = true;
  } else {
    if (document.exitFullscreen && document.fullscreenElement) {
      document.exitFullscreen().catch(() => cssFullscreen(false));
    } else {
      cssFullscreen(false);
    }
    isFullscreen = false;
  }
}

function cssFullscreen(on) {
  const w = document.getElementById('finderWindow');
  w.classList.toggle('fullscreen', on);
  document.body.classList.toggle('is-fullscreen', on);
}

document.addEventListener('fullscreenchange', () => {
  if (!document.fullscreenElement) { cssFullscreen(false); isFullscreen = false; }
  else { cssFullscreen(true); }
});

// ═══════════════════════════════════════════
//  LANGUAGE
// ═══════════════════════════════════════════
function toggleLang() {
  lang = lang === 'en' ? 'ru' : 'en';
  document.getElementById('langBtn').textContent = lang === 'en' ? 'RU' : 'EN';
  document.getElementById('htmlRoot').lang = lang;
  selectedId = null;
  clearDetail();
  applyI18n();
  renderContent();
}

function applyI18n() {
  const s = d().sections;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.dataset.i18n;
    if (s[k]) el.textContent = s[k];
  });
  document.getElementById('searchInput').placeholder = lang === 'en' ? 'Search' : 'Поиск';
  const dpHint = document.getElementById('dpHint');
  if (dpHint) dpHint.innerHTML = s.dp_hint.replace('\n','<br>');
}

// ═══════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════
function navigate(sec, push=true, keepFilter=false) {
  if (!keepFilter) {
    query = '';
    document.getElementById('searchInput').value = '';
  }
  document.querySelectorAll('.sb-item').forEach(e => e.classList.remove('active'));
  document.querySelectorAll('.mob-tab').forEach(e => e.classList.remove('active'));
  const si = document.getElementById('si-' + sec);
  const mt = document.getElementById('mt-' + sec);
  if (si) si.classList.add('active');
  if (mt) mt.classList.add('active');
  section   = sec;
  selectedId = null;
  if (push) { hist = hist.slice(0, hIdx+1); hist.push(sec); hIdx = hist.length-1; }
  updateNavBtns();
  renderContent();
  clearDetail();
}

function updateNavBtns() {
  document.getElementById('btnBack').disabled = hIdx <= 0;
  document.getElementById('btnFwd').disabled  = hIdx >= hist.length-1;
}
function goBack() { if (hIdx>0) { hIdx--; navigate(hist[hIdx],false); } }
function goFwd()  { if (hIdx<hist.length-1) { hIdx++; navigate(hist[hIdx],false); } }

// ═══════════════════════════════════════════
//  VIEW & SEARCH
// ═══════════════════════════════════════════
function setView(v) {
  view = v;
  document.getElementById('vIcon').classList.toggle('active', v==='icon');
  document.getElementById('vList').classList.toggle('active', v==='list');
  renderContent();
}

function handleSearch(val) {
  query = val.toLowerCase();
  if (query && section !== 'projects') navigate('projects', true, true);
  else renderContent();
}

function filterTag(t) { query = t; navigate('projects', true, true); }

// ═══════════════════════════════════════════
//  RENDER ROUTER
// ═══════════════════════════════════════════
function renderContent() {
  const inner = document.getElementById('contentInner');
  const title = d().sections[section] || section;
  document.getElementById('toolbarTitle').textContent = title;
  document.getElementById('pathCurrent').textContent  = title;
  inner.innerHTML = '';
  const map = {about:renderAbout,projects:renderProjects,skills:renderSkills,experience:renderExp,contact:renderContact};
  if (map[section]) map[section](inner);
}

// ─── ABOUT ───
function renderAbout(el) {
  setStatus('1');
  const m = d();
  el.innerHTML = `
  <div class="sec">
    <div class="card">
      <div class="avatar" id="aboutAvatar">${m.initials}</div>
      <div class="about-name">${m.name}</div>
      <div class="about-role">${m.role}</div>
      <div class="about-bio">${m.bio}</div>
      <div class="chips">
        <a class="chip" href="mailto:${m.email}">✉️ ${m.email}</a>
        <a class="chip" href="${m.tg}" target="_blank">✈️ Telegram</a>
        <a class="chip" href="${m.web}" target="_blank">🌐 ${m.web.replace('https://','')}</a>
      </div>
    </div>
    <div class="info-grid">
      <div class="info-tile"><div class="it-lbl">${lang==='en'?'Location':'Город'}</div><div class="it-val">📍 ${m.location}</div></div>
      <div class="info-tile"><div class="it-lbl">${lang==='en'?'Status':'Статус'}</div><div class="it-val" style="color:#27ae60;font-size:13px">● ${m.available}</div></div>
      <div class="info-tile"><div class="it-lbl">${lang==='en'?'Experience':'Опыт'}</div><div class="it-val">${m.experience_years}</div></div>
      <div class="info-tile"><div class="it-lbl">${lang==='en'?'Projects':'Проекты'}</div><div class="it-val">${m.projects_count}</div></div>
    </div>
  </div>`;
  // Load avatar image without inline handlers
  const av = document.getElementById('aboutAvatar');
  const img = new Image();
  img.onload = () => {
    av.textContent = '';
    av.style.backgroundImage = `url('${img.src}')`;
    av.style.backgroundSize = 'cover';
    av.style.backgroundPosition = 'center';
  };
  img.src = 'https://bogdanzaless.ru/avatar.png';
}

// ─── PROJECTS ───
function renderProjects(el) {
  let items = d().projects;
  if (query) items = items.filter(p =>
    p.name.toLowerCase().includes(query) ||
    p.tags.some(t => t.toLowerCase().includes(query)) ||
    p.color.includes(query) || p.type.toLowerCase().includes(query)
  );
  setStatus(items.length + (lang==='en'?' items':' элем.'));
  if (!items.length) {
    el.innerHTML = `<div style="text-align:center;padding:60px 20px;color:#ccc"><div style="font-size:40px;margin-bottom:10px">🔍</div><p>${lang==='en'?'No results for':'Нет результатов по'} "${query}"</p></div>`;
    return;
  }
  if (view==='icon') {
    const g = document.createElement('div'); g.className='icon-grid';
    items.forEach(p => {
      const d2 = document.createElement('div'); d2.className='icon-item';
      if (p.id===selectedId) d2.classList.add('selected');
      d2.innerHTML = `<div class="fi">${p.icon}</div><div class="fn">${p.name}</div>`;
      d2.onclick = () => selectProject(p, d2);
      g.appendChild(d2);
    });
    el.appendChild(g);
  } else {
    const w = document.createElement('div'); w.className='list-view';
    w.innerHTML = `<div class="list-hdr"><span>${lang==='en'?'Name':'Название'}</span><span>${lang==='en'?'Type':'Тип'}</span><span>${lang==='en'?'Year':'Год'}</span></div>`;
    items.forEach(p => {
      const r = document.createElement('div'); r.className='list-row';
      if (p.id===selectedId) r.classList.add('selected');
      r.innerHTML = `<div class="row-name"><span class="row-icon">${p.icon}</span>${p.name}</div><div class="row-meta">${p.type}</div><div class="row-meta">${p.date}</div>`;
      r.onclick = () => selectProject(p, r);
      w.appendChild(r);
    });
    el.appendChild(w);
  }
}

function selectProject(p, el2) {
  document.querySelectorAll('.icon-item,.list-row').forEach(e => e.classList.remove('selected'));
  el2.classList.add('selected');
  selectedId = p.id;
  const html = `
    <div class="dp-icon">${p.icon}</div>
    <div class="dp-name">${p.name}</div>
    <div class="dp-type">${p.type}</div>
    <hr class="dp-divider">
    <div class="dp-sec">${lang==='en'?'Info':'Инфо'}</div>
    <div class="dp-row"><span class="dk">${lang==='en'?'Type':'Тип'}</span><span class="dv">${p.type}</span></div>
    <div class="dp-row"><span class="dk">${lang==='en'?'Year':'Год'}</span><span class="dv">${p.date}</span></div>
    <div class="dp-row"><span class="dk">${lang==='en'?'Size':'Размер'}</span><span class="dv">${p.size}</span></div>
    <hr class="dp-divider">
    <div class="dp-sec">${lang==='en'?'Description':'Описание'}</div>
    <div class="dp-desc">${p.desc}</div>
    <hr class="dp-divider">
    <div class="dp-sec">${lang==='en'?'Tags':'Теги'}</div>
    <div class="tag-list">${p.tags.map(t=>`<span class="tag">${t}</span>`).join('')}</div>
    ${p.link
      ? `<a class="dp-link" href="${p.link}" target="_blank">📰 ${lang==='en'?'Read on Sostav.ru ↗':'Читать на Sostav.ru ↗'}</a>`
      : `<a class="dp-link" href="https://bogdanzaless.ru" target="_blank">🔗 ${lang==='en'?'View Portfolio ↗':'Портфолио ↗'}</a>`
    }`;
  document.getElementById('detailPanel').innerHTML = html;
  // Mobile: open bottom sheet
  if (window.innerWidth <= 768) {
    document.getElementById('bsContent').innerHTML = html;
    document.getElementById('bottomSheet').classList.add('open');
  }
}

// ─── SKILLS ───
function renderSkills(el) {
  const skills = d().skills;
  const total = skills.reduce((s,g)=>s+g.items.length,0);
  setStatus(total + (lang==='en'?' skills':' навыков'));
  let html = '<div class="sec">';
  skills.forEach(g => {
    html += `<div><div class="dp-sec" style="font-size:12px;margin-bottom:10px">${g.cat}</div>`;
    g.items.forEach(([n,pct]) => {
      html += `<div class="skill-group"><div class="skill-lbl"><span>${n}</span><span>${pct}%</span></div><div class="bar-bg"><div class="bar" data-w="${pct}"></div></div></div>`;
    });
    html += '</div>';
  });
  html += '</div>';
  el.innerHTML = html;
  setTimeout(() => el.querySelectorAll('.bar').forEach(b => { b.style.width = b.dataset.w+'%'; }), 60);
}

// ─── EXPERIENCE ───
function renderExp(el) {
  const exp = d().experience;
  setStatus(exp.length + (lang==='en'?' positions':' позиции'));
  let html = '<div class="sec">';
  exp.forEach(e => {
    html += `<div class="exp-item"><div class="exp-role">${e.role}</div><div class="exp-co">${e.company}</div><div class="exp-per">📅 ${e.period}</div><div class="exp-desc">${e.desc}</div></div>`;
  });
  html += '</div>';
  el.innerHTML = html;
}

// ─── CONTACT ───
function renderContact(el) {
  const m = d();
  setStatus('3');
  el.innerHTML = `
  <div class="sec">
    <div class="card">
      <div style="font-size:28px;margin-bottom:10px">👋</div>
      <div class="about-name" style="font-size:17px">${lang==='en'?"Let's work together":'Давай создадим что-то крутое'}</div>
      <div class="about-bio">${lang==='en'?'Open to brand projects, art direction, campaigns and digital work. Usually reply within 12 hours.':'Открыт для брендовых проектов, арт-дирекшна, кампаний и цифровых продуктов. Обычно отвечаю в течение 12 часов.'}</div>
      <div class="chips" style="margin-top:14px">
        <a class="chip" href="mailto:${m.email}" style="font-size:13px;padding:7px 14px">✉️ Email</a>
        <a class="chip" href="${m.tg}" target="_blank" style="font-size:13px;padding:7px 14px">✈️ Telegram</a>
        <a class="chip" href="${m.web}" target="_blank" style="font-size:13px;padding:7px 14px">🌐 Website</a>
      </div>
    </div>
    <div class="info-grid">
      <div class="info-tile"><div class="it-lbl">${lang==='en'?'Response':'Ответ'}</div><div class="it-val">${m.resp_time}</div></div>
      <div class="info-tile"><div class="it-lbl">${lang==='en'?'Timezone':'Тайм-зона'}</div><div class="it-val">${m.timezone}</div></div>
    </div>
  </div>`;
}

// ═══════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════
function setStatus(n) {
  document.getElementById('statusText').textContent =
    typeof n === 'number' ? n + (lang==='en'?' items':' элем.') : n;
}
function clearDetail() {
  const s = d().sections;
  document.getElementById('detailPanel').innerHTML = `<div class="dp-empty"><div class="dp-ei">ℹ️</div><p id="dpHint">${s.dp_hint.replace('\n','<br>')}</p></div>`;
}
function closeBottomSheet() { document.getElementById('bottomSheet').classList.remove('open'); }
function openLink(u) { window.open(u,'_blank'); }

// ═══════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════
applyI18n();
renderContent();
</script>
</body>
</html>
