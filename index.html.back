        <input type="text" id="searchInput" oninput="handleSearch(this.value)">
      </div>
    </div>
  </div>

  <!-- BODY -->
  <div class="finder-body">

    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="sb-label" data-i18n="fav">Favorites</div>
      <div class="sb-item active" id="si-about" onclick="navigate('about')">
        <div class="si-icon">🏠</div><span data-i18n="about">About</span>
      </div>
      <div class="sb-item" id="si-projects" onclick="navigate('projects')">
