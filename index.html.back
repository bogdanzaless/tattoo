      </div>
      <div class="sb-label" data-i18n="connect">Connect</div>
      <div class="sb-item" id="si-contact" onclick="navigate('contact')">
        <div class="si-icon">✉️</div><span data-i18n="contact">Contact</span>
      </div>
      <div class="sb-item" onclick="openLink('https://t.me/bogdan_zaless')">
        <div class="si-icon">✈️</div><span>Telegram</span>
      </div>
      <div class="sb-item" onclick="openLink('https://bogdanzaless.ru')">
