<!-- Closed overlay -->
<div id="closedOverlay" onclick="reopenWindow()">
  <div class="di-icon">📁</div>
  <div class="di-label">bogdan_zaless.ru</div>
</div>

<!-- Mini dock (minimized) -->
<div id="miniDock" onclick="restoreWindow()">
  <div class="dock-icon">📁</div>
  <div class="dock-label">bogdan_zaless.ru</div>
</div>

<!-- Bottom sheet (mobile detail) -->
<div id="bottomSheet">
  <div class="bs-backdrop" onclick="closeBottomSheet()"></div>
  <div class="bs-panel" id="bsPanel">
    <div class="bs-handle"></div>
    <div class="bs-content" id="bsContent"></div>
  </div>
</div>

<!-- ══════ FINDER WINDOW ══════ -->
<div class="finder-window" id="finderWindow">

  <!-- TOOLBAR -->
  <div class="toolbar">
