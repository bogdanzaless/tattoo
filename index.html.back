/* ── Theme toggle button ── */
.theme-btn{
  width:28px;height:28px;background:none;border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-size:15px;border-radius:6px;
  transition:background 0.12s;flex-shrink:0;
}
.theme-btn:hover{background:rgba(0,0,0,0.08)}

/* ── Mobile tabs — bigger touch targets ── */
@media(max-width:768px){
  .mob-tabs-inner{padding:6px 0 calc(10px + env(safe-area-inset-bottom))}
  .mob-tab{padding:6px 4px;gap:4px;border-radius:10px}
  .mt-icon{font-size:26px}
  .mt-lbl{font-size:11px;font-weight:500}
}
