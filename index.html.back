        <div class="si-icon" style="color:#e74c3c">●</div><span>Branding</span>
      </div>
      <div class="sb-item" onclick="filterTag('motion')">
        <div class="si-icon" style="color:#9b59b6">●</div><span>Motion</span>
      </div>
      <div class="sb-item" onclick="filterTag('digital')">
