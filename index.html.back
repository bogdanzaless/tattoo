      <div class="tl red"    title="Close"    onclick="tlClose()"></div>
      <div class="tl yellow" title="Minimize" onclick="tlMinimize()"></div>
      <div class="tl green"  title="Fullscreen" onclick="tlFullscreen()"></div>
    </div>
