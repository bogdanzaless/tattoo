      <button class="nav-btn" id="btnBack" disabled onclick="goBack()">‹</button>
      <button class="nav-btn" id="btnFwd"  disabled onclick="goFwd()">›</button>
    </div>
    <div class="toolbar-title" id="toolbarTitle">bogdan_zaless</div>
    <div class="toolbar-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()" title="Toggle theme">☀️</button>
